<?xml version="1.0"?>
<robot name="proto6">
  <material name="orange"><color rgba="0.95 0.45 0.1 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.17 1"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.62 1"/></material>

  <link name="base">
    <inertial><origin xyz="0 0 0.03" rpy="0 0 0"/><mass value="1.5"/>
      <inertia ixx="0.002288" iyy="0.002288" izz="0.003675" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><cylinder radius="0.07" length="0.06"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><cylinder radius="0.07" length="0.06"/></geometry></collision>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base"/><child link="shoulder"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-2.97" upper="2.97" effort="5.0" velocity="2.5"/><dynamics damping="0.5" friction="0.05"/>
  </joint>

  <link name="shoulder">
    <inertial><origin xyz="0 0 0.05" rpy="0 0 0"/><mass value="2.2"/>
      <inertia ixx="0.003497" iyy="0.003497" izz="0.003328" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.055" length="0.1"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.055" length="0.1"/></geometry></collision>
  </link>

  <joint name="j2" type="revolute">
    <parent link="shoulder"/><child link="upper"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-1.75" upper="1.75" effort="20.0" velocity="1.2"/><dynamics damping="0.5" friction="0.05"/>
  </joint>

  <link name="upper">
    <inertial><origin xyz="0 0 0.1" rpy="0 0 0"/><mass value="0.7"/>
      <inertia ixx="0.002468" iyy="0.002543" izz="0.000344" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="0.06 0.048 0.2"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><box size="0.06 0.048 0.2"/></geometry></collision>
  </link>

  <joint name="j3" type="revolute">
    <parent link="upper"/><child link="fore_a"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="20.0" velocity="1.2"/><dynamics damping="0.5" friction="0.05"/>
  </joint>

  <link name="fore_a">
    <inertial><origin xyz="0 0 0.05" rpy="0 0 0"/><mass value="0.39"/>
      <inertia ixx="0.000425" iyy="0.000425" izz="0.000200" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.032" length="0.1"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.032" length="0.1"/></geometry></collision>
  </link>

  <joint name="j4" type="revolute">
    <parent link="fore_a"/><child link="fore_b"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-3.05" upper="3.05" effort="1.5" velocity="3.0"/><dynamics damping="0.5" friction="0.05"/>
  </joint>

  <link name="fore_b">
    <inertial><origin xyz="0 0 0.039999999999999994" rpy="0 0 0"/><mass value="0.26"/>
      <inertia ixx="0.000193" iyy="0.000193" izz="0.000108" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.039999999999999994" rpy="0 0 0"/><geometry><cylinder radius="0.028800000000000003" length="0.07999999999999999"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0 0 0.039999999999999994" rpy="0 0 0"/><geometry><cylinder radius="0.028800000000000003" length="0.07999999999999999"/></geometry></collision>
  </link>

  <joint name="j5" type="revolute">
    <parent link="fore_b"/><child link="wrist"/>
    <origin xyz="0 0 0.07999999999999999" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2.1" upper="2.1" effort="1.5" velocity="3.0"/><dynamics damping="0.5" friction="0.05"/>
  </joint>

  <link name="wrist">
    <inertial><origin xyz="0 0 0.025" rpy="0 0 0"/><mass value="0.3"/>
      <inertia ixx="0.000121" iyy="0.000121" izz="0.000118" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><cylinder radius="0.028" length="0.05"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.025" rpy="0 0 0"/><geometry><cylinder radius="0.028" length="0.05"/></geometry></collision>
  </link>

  <joint name="j6" type="revolute">
    <parent link="wrist"/><child link="flange"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-3.05" upper="3.05" effort="0.5" velocity="4.0"/><dynamics damping="0.5" friction="0.05"/>
  </joint>

  <link name="flange">
    <inertial><origin xyz="0 0 0.01" rpy="0 0 0"/><mass value="0.1"/>
      <inertia ixx="0.000019" iyy="0.000019" izz="0.000031" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.01" rpy="0 0 0"/><geometry><cylinder radius="0.025" length="0.02"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0.01" rpy="0 0 0"/><geometry><cylinder radius="0.025" length="0.02"/></geometry></collision>
  </link>

  <joint name="palm_fix" type="fixed">
    <parent link="flange"/><child link="palm"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><dynamics damping="0.5" friction="0.05"/>
  </joint>

  <link name="palm">
    <inertial><origin xyz="0 0 0.015" rpy="0 0 0"/><mass value="0.25"/>
      <inertia ixx="0.000227" iyy="0.000071" izz="0.000260" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.015" rpy="0 0 0"/><geometry><box size="0.05 0.1 0.03"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0.015" rpy="0 0 0"/><geometry><box size="0.05 0.1 0.03"/></geometry></collision>
  </link>

  <joint name="finger_left" type="prismatic">
    <parent link="palm"/><child link="finger_left"/>
    <origin xyz="0 0.0075 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="40" velocity="0.2"/>
    <dynamics damping="2.0" friction="0.1"/>
  </joint>

  <link name="finger_left">
    <inertial><origin xyz="0 0 0.0275" rpy="0 0 0"/><mass value="0.03"/>
      <inertia ixx="0.000008" iyy="0.000008" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.0275" rpy="0 0 0"/><geometry><box size="0.012 0.015 0.055"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.0275" rpy="0 0 0"/><geometry><box size="0.012 0.015 0.055"/></geometry></collision>
  </link>

  <joint name="finger_right" type="prismatic">
    <parent link="palm"/><child link="finger_right"/>
    <origin xyz="0 -0.0075 0.03" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.04" effort="40" velocity="0.2"/>
    <dynamics damping="2.0" friction="0.1"/>
  </joint>

  <link name="finger_right">
    <inertial><origin xyz="0 0 0.0275" rpy="0 0 0"/><mass value="0.03"/>
      <inertia ixx="0.000008" iyy="0.000008" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><origin xyz="0 0 0.0275" rpy="0 0 0"/><geometry><box size="0.012 0.015 0.055"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0.0275" rpy="0 0 0"/><geometry><box size="0.012 0.015 0.055"/></geometry></collision>
  </link>

  <joint name="grasp_fix" type="fixed">
    <parent link="flange"/><child link="grasp_target"/>
    <origin xyz="0 0 0.09300000000000001" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><dynamics damping="0.5" friction="0.05"/>
  </joint>
  <link name="grasp_target"><inertial><mass value="0.001"/><inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/></inertial></link>
</robot>
